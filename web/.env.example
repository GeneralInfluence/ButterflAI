# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000
BASE_URL=https://your-app.fly.dev
WEBHOOK_SECRET=change-me-to-something-random

# ── Database ──────────────────────────────────────────────────────────────────
DB_PATH=../data/butterflai.sqlite

# ── Twilio (primary human channel) ───────────────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_FROM_NUMBER=+15551234567   # Your Twilio phone number (E.164)

# ── KMS / Encryption ─────────────────────────────────────────────────────────
# KMS_PROVIDER=local uses a master key from env (dev only — do NOT use in production).
# For production, set KMS_PROVIDER=aws (or gcp/azure) and configure the relevant SDK.
KMS_PROVIDER=local
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
KMS_MASTER_KEY_HEX=replace_with_64_hex_chars

# ── Telegram (optional — retained for future international/B2B use) ───────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# ── Node env ──────────────────────────────────────────────────────────────────
NODE_ENV=development
