# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000
BASE_URL=https://your-app.fly.dev
WEBHOOK_SECRET=change-me-to-something-random

# ── Database ──────────────────────────────────────────────────────────────────
DB_PATH=../data/butterflai.sqlite

# ── Twilio (primary human channel) ───────────────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_FROM_NUMBER=+15551234567   # Your Twilio phone number (E.164)

# ── KMS / Encryption ─────────────────────────────────────────────────────────
# KMS_PROVIDER=local uses a master key from env (dev only — do NOT use in production).
# For production, set KMS_PROVIDER=aws (or gcp/azure) and configure the relevant SDK.
KMS_PROVIDER=local
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
KMS_MASTER_KEY_HEX=replace_with_64_hex_chars

# ── Telegram (optional — retained for future international/B2B use) ───────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# ── Google OAuth (calendar + contacts) ───────────────────────────────────────
GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_client_secret
# Must be registered in Google Cloud Console as an allowed redirect URI:
GOOGLE_REDIRECT_URI=https://your-app.fly.dev/auth/google/callback

# ── Google Places API (venue suggestions) ────────────────────────────────────
# Enable "Places API (New)" in Google Cloud Console — same project as OAuth
GOOGLE_PLACES_API_KEY=your_places_api_key_here

# ── Cadence nudge loop ────────────────────────────────────────────────────────
NUDGE_THRESHOLD=0.9          # nudge when this fraction of the interval has elapsed
NUDGE_INTERVAL_MS=14400000   # how often to scan (ms); default 4 hours

# ── Agent (Claude) ───────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
AGENT_MODEL=claude-3-5-haiku-20241022   # fast+cheap for the polling loop
AGENT_POLL_MS=5000                       # how often to check the inbound queue

# ── Node env ──────────────────────────────────────────────────────────────────
NODE_ENV=development
